# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file

# gitlab config
.gitlab/

# Exclude all .git directories to prevent cache invalidation
.git/
**/.git/

# Build artifacts
bin/
artifacts/
*.tgz
*.tar.gz
*.zip

# Temporary and cache files
*.swp
*.swo
*~
.DS_Store
.gocache/
*/.cache/

# Logs
*.log
*.out

# Don't copy hack directory (except needed files)
hack/*
!hack/tools/tools.mk
!hack/boilerplate.go.txt
# Exclude generated files that contain TAG and would invalidate cache
hack/repos/**/values.yaml
dpuservices/**/values.yaml
deploy/charts/**/values.yaml
internal/release/manifests/defaults.yaml

# Other directories not needed for build
.vscode/
.idea/
