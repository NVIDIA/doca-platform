ARG builder_image
ARG base_image=ubuntu:22.04
ARG bfb_registry_base_image

# NVIDIA PLDM-unpack (MIT): https://github.com/NVIDIA/PLDM-unpack
# Pinned commit for reproducible builds; override with --build-arg PLDM_UNPACK_REF=<git-sha>.
FROM ${base_image} AS pldm-unpack-fetch
ARG PLDM_UNPACK_REF=44f734f828dd27866f32669e4f0b5e7d7065f654
ARG PLDM_UNPACK_SHA256=35106367f040d0e7256f608eeda2704792d7769a5238aba08c874e2598b9cb77
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/pldm-unpack && \
    wget -q -O /opt/pldm-unpack/fwpkg_unpack.py \
      "https://raw.githubusercontent.com/NVIDIA/PLDM-unpack/${PLDM_UNPACK_REF}/fwpkg_unpack.py" && \
    echo "${PLDM_UNPACK_SHA256}  /opt/pldm-unpack/fwpkg_unpack.py" | sha256sum -c - && \
    wget -q -O /opt/pldm-unpack/License-MIT-fwpkg-unpack.txt \
      "https://raw.githubusercontent.com/NVIDIA/PLDM-unpack/${PLDM_UNPACK_REF}/License-MIT-fwpkg-unpack.txt" && \
    chmod 755 /opt/pldm-unpack/fwpkg_unpack.py

# Stage 1: Build Nginx
FROM ${base_image} AS builder

ARG TARGETARCH
ARG nginx_version=1.30.1

ARG PACKAGES="wget unzip build-essential libpcre3 libpcre3-dev libssl-dev zlib1g-dev gettext"

# Enable deb-src to be able to fetch sources
RUN sed -i 's/^# deb-src/deb-src/g' /etc/apt/sources.list

ARG ubuntu_mirror=http://archive.ubuntu.com/ubuntu/
RUN find /etc/apt/sources.list* -type f -exec sed -i \
      -e "s|http://archive.ubuntu.com/ubuntu/|${ubuntu_mirror}|g" \
      -e "s|http://ports.ubuntu.com/ubuntu/|${ubuntu_mirror}|g" \
      -e "s|http://security.ubuntu.com/ubuntu/|${ubuntu_mirror}|g" '{}' \;

# Workaround libc-bin/dpkg trigger crashes under QEMU by diverting ldconfig
# This prevents segfaults during ARM64 emulation on x86 hosts.
#
# Note: We run the binfmt container to enable multi-architecture builds in CI,
# but this workaround is still needed to build the images locally.
# 
# The fix: dpkg-divert renames real ldconfig, then we symlink it to /bin/true.
# When libc-bin triggers run, they execute /bin/true (no-op) instead of crashing.
# After install, we restore the original ldconfig.
# 
# References:
#   - Debian bug #981068: https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=981068
#   - Docker Buildx issue: https://github.com/docker/buildx/issues/314
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get install -y -qq ca-certificates git autoconf automake libtool && \
    echo "libc-bin libc-bin/upgrade-libraries boolean false" | debconf-set-selections || true && \
    dpkg-divert --local --rename --add /sbin/ldconfig || true && \
    ln -s /bin/true /sbin/ldconfig || true && \
    apt-get install -y -qq ${PACKAGES} && \
    rm -f /sbin/ldconfig && \
    dpkg-divert --local --rename --remove /sbin/ldconfig || true && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
RUN wget https://github.com/nginx/nginx/archive/refs/tags/release-${nginx_version}.zip && unzip release-${nginx_version}.zip
RUN git clone https://github.com/alibaba/nginx-http-concat.git && cd nginx-http-concat && git checkout b8d3e7ec511724a6900ba3915df6b504337891a9
RUN tar -czf nginx-http-concat.tar.gz nginx-http-concat

WORKDIR /workspace/nginx-release-${nginx_version}
RUN auto/configure  --add-module=/workspace/nginx-http-concat
RUN make -j $(nproc) && make install

# Create necessary directories in the builder stage
RUN mkdir -p /nginx

# Move source code to a directory
WORKDIR /workspace
ARG PACKAGE_SOURCES
# First, create a dummy source-code.tar file to avoid copy failures.
RUN touch /workspace/source-code.tar.gz
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    test "${PACKAGE_SOURCES}" = "false" || ( \
      mkdir src && \
      cd src && \
      cp /workspace/release-${nginx_version}.zip . && \
      cp /workspace/nginx-http-concat.tar.gz . && \
      apt-get update && \
      apt-get source --download-only ${PACKAGES} && \
      cd /workspace && \
      tar -cfz source-code.tar.gz src \
    )

# Prepare architecture-specific libraries (for multi-arch support)
FROM ${base_image} AS lib-selector
ARG TARGETARCH

COPY --from=builder /lib /tmp/lib

# Map TARGETARCH (amd64/arm64) to GNU triplet and copy architecture-specific libraries
RUN case ${TARGETARCH} in \
        amd64) GNU_ARCH=x86_64-linux-gnu ;; \
        arm64) GNU_ARCH=aarch64-linux-gnu ;; \
        *) echo "Unsupported architecture: ${TARGETARCH}" && exit 1 ;; \
    esac && \
    mkdir -p /output/lib/${GNU_ARCH} && \
    cp -a /tmp/lib/${GNU_ARCH}/libpcre.so* \
          /tmp/lib/${GNU_ARCH}/libssl.so* \
          /tmp/lib/${GNU_ARCH}/libcrypto.so* \
          /tmp/lib/${GNU_ARCH}/libz.so* \
          /tmp/lib/${GNU_ARCH}/libcrypt.so* \
          /output/lib/${GNU_ARCH}/

# Stage 2: Build dpuagent binary.
FROM --platform=${BUILDPLATFORM} ${builder_image} AS dpuagent-builder
WORKDIR /workspace

# Copy source files needed for proper vendoring
COPY go.mod go.sum ./
COPY third_party/ third_party/
COPY api/ api/
COPY cmd/ cmd/
COPY test/ test/
COPY internal/ internal/
COPY pkg/ pkg/

ARG gcflags
ARG ldflags
ARG TARGETARCH

ENV GO_LDFLAGS=${ldflags}
ENV GO_GCFLAGS=${gcflags}
ENV ARCH=${TARGETARCH}
ENV TAG=${TAG}

# Vendor dependencies first
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod vendor

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=bind,source=Makefile,target=Makefile \
    --mount=type=bind,source=hack/tools/tools.mk,target=hack/tools/tools.mk \
    GOFLAGS="-mod=vendor" make binary-dpuagent binary-pldmunpackserver

# Copy the go source code so it can be distributed in the final image.
RUN mkdir src && \
    find . -name '*.go' -not -path "./hack/*" -not -path "./.gocache/*" \
    -exec cp --parents \{\}  src/ \; && \
    tar -czf source-code.tar.gz src

# DPU Agent packager stage - packages binary with actual TAG version
FROM --platform=${BUILDPLATFORM} ${builder_image} AS dpuagent-packager
WORKDIR /workspace

# Install rpm tools (required by nfpm for creating .rpm packages)
RUN apt-get update && apt-get install -y --no-install-recommends rpm dpkg-dev createrepo-c && rm -rf /var/lib/apt/lists/*

# Copy packaging configuration and binary from builder
COPY internal/provisioning/dpuagent/packaging/ internal/provisioning/dpuagent/packaging/
COPY --from=dpuagent-builder /workspace/bin/dpuagent /workspace/bin/dpuagent

# Package with actual TAG version (binary already built, just call packaging targets)
ARG TAG
RUN --mount=type=cache,target=/workspace/hack/tools/bin \
    --mount=type=bind,source=Makefile,target=Makefile \
    --mount=type=bind,source=hack/tools/tools.mk,target=hack/tools/tools.mk \
    make deb-dpuagent rpm-dpuagent

# Copy dpu-agent packages built with actual TAG version
RUN mkdir -p /deb /rpm \
    && cp /workspace/bin/dpu-agent_*_arm64.deb /deb/ \
    && cp /workspace/bin/dpu-agent-*.aarch64.rpm /rpm/

# Generate APT repository metadata
WORKDIR /deb
RUN dpkg-scanpackages -m . > Packages && gzip -k Packages

# Generate YUM/DNF repository metadata
WORKDIR /rpm
RUN createrepo_c .

# Stage 3: Create final image based on bfb-registry base image
FROM ${bfb_registry_base_image}

# copy the tengine source code
ARG version=3.1.0
COPY --from=builder /workspace/source-code.tar.gz source-code.tar.gz
COPY --from=dpuagent-builder /workspace/source-code.tar.gz dpuagent-source-code.tar.gz

# Copy architecture-specific libraries from lib-selector stage
COPY --from=lib-selector /output/lib/ /lib/
COPY --from=builder /bin/sh /bin/
COPY --from=builder /bin/envsubst /bin/
# ${uid}:${uid} can execute the binary but can not modify it. Refer to https://sonar-sw.nvidia.com/coding_rules?open=docker%3AS6504&rule_key=docker%3AS6504 for more details.
COPY --chown=root:root --chmod=755 --from=builder /usr/local/nginx /usr/local/nginx

ENV uid=65532

# Copy nginx directory with non-root ownership. The directory is copied instead of created to avoid the need of mkdir and chown binaries.
# nginx.conf and all the temp files are in the /nginx directory.
# This approach complies with S6504 because we're only changing ownership of non-executable directories
COPY --chown=${uid}:${uid} --chmod=700 --from=builder /nginx /nginx

# Copy APT/YUM repositories containing dpu-agent packages
COPY --from=dpuagent-packager /deb /deb
COPY --from=dpuagent-packager /rpm /rpm

# PLDM firmware package unpacker (Python 3.8+; stdlib only). Run: python3 /opt/pldm-unpack/fwpkg_unpack.py --help
COPY --chown=root:root --from=pldm-unpack-fetch /opt/pldm-unpack /opt/pldm-unpack

# PLDM unpack HTTP server (Unix socket); default script: /opt/pldm-unpack/fwpkg_unpack.py
COPY --chown=root:root --chmod=755 --from=dpuagent-builder /workspace/bin/pldmunpackserver /usr/local/bin/pldmunpackserver

USER ${uid}:${uid}
