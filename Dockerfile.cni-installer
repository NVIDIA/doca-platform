ARG builder_image
ARG base_image
ARG rdma_cni_version=network-operator-v26.7.0
ARG cni_plugins_version=network-operator-v26.7.0

# 1) dependency stage to create a dependency layer with go vendor folder and other dependencies
FROM --platform=${BUILDPLATFORM} ${builder_image} AS dependency
WORKDIR /workspace
ARG rdma_cni_version
ARG cni_plugins_version

# Copy source files needed for proper vendoring
COPY go.mod go.sum ./
COPY third_party/ third_party/
COPY api/ api/
COPY cmd/ cmd/
COPY test/ test/
COPY internal/ internal/
COPY pkg/ pkg/

# Vendor all dependencies with go build cache
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod vendor

# Copy the go source code so it can be distributed in the final image.
RUN mkdir -p src/dpf && \
    wget https://github.com/Mellanox/rdma-cni/archive/refs/tags/${rdma_cni_version}.tar.gz -O src/rdma-cni-${rdma_cni_version}.tar.gz && \
    wget https://github.com/Mellanox/k8snetworkplumbingwg-plugins/archive/refs/tags/${cni_plugins_version}.tar.gz -O src/cni-plugins-${cni_plugins_version}.tar.gz && \
    find . -name '*.go' -not -path "./hack/*" -not -path "./.gocache/*" \
    -exec cp --parents \{\}  src/dpf/ \; && \
    tar -czf source-code.tar.gz src

# 2) Builder stage builds go binaries (no emulation).
FROM --platform=${BUILDPLATFORM} ${builder_image} AS builder
WORKDIR /workspace

ARG gcflags
ARG ldflags
ARG TARGETARCH

ENV GO_LDFLAGS=${ldflags}
ENV GO_GCFLAGS=${gcflags}
ENV ARCH=${TARGETARCH}

# Copy the source code from the dependency image
COPY --from=dependency /workspace .

# Build the installer plus every CNI binary it ships, in a single make
# invocation so they share the go-build cache mount.
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=bind,source=Makefile,target=Makefile \
    --mount=type=bind,source=hack/tools/tools.mk,target=hack/tools/tools.mk \
    GOFLAGS="-mod=vendor" make binary-cni-installer binary-sfc-cni

# 3) Declare images to copy binaries from. The reason we declare them here is so that we can parameterise the version.
FROM --platform=${TARGETPLATFORM} nvcr.io/nvidia/mellanox/rdma-cni:${rdma_cni_version} AS rdmacni
FROM --platform=${TARGETPLATFORM} nvcr.io/nvidia/mellanox/plugins:${cni_plugins_version} AS cniplugins

# 4) Final stage copies artefacts from the builder and dependency stages.
FROM ${base_image}
ARG TARGETARCH

WORKDIR /

# Ensure all files are copied with the correct user.
ENV uid=65532
USER ${uid}:${uid}

# Add the source code.
COPY --chown=${uid} --from=dependency /workspace/source-code.tar.gz source-code.tar.gz

# Add the CNI Installer binary
COPY --chown=${uid} --chmod=755 --from=builder /workspace/bin/cni-installer .

# Stage each CNI binary at /opt/cnis/<name>. The installer copies everything it finds there to
# /opt/cni/bin/ at runtime.
COPY --chown=${uid} --chmod=755 --from=rdmacni /usr/bin/rdma /opt/cnis/rdma
# Keep name ovs to match NAD type dispatch.
COPY --chown=${uid} --chmod=755 --from=builder /workspace/bin/ovs /opt/cnis/ovs
# The standard containernetworking CNIs, which the BFB used to provide via the kubernetes-cni
# package. Copied individually from the NVIDIA Mellanox plugins image's compiled binaries at
# /usr/src/cni/bin/<name>.
COPY --chown=${uid} --chmod=755 --from=cniplugins /usr/src/cni/bin/host-device /opt/cnis/host-device
COPY --chown=${uid} --chmod=755 --from=cniplugins /usr/src/cni/bin/loopback /opt/cnis/loopback
COPY --chown=${uid} --chmod=755 --from=cniplugins /usr/src/cni/bin/dhcp /opt/cnis/dhcp
COPY --chown=${uid} --chmod=755 --from=cniplugins /usr/src/cni/bin/static /opt/cnis/static
COPY --chown=${uid} --chmod=755 --from=cniplugins /usr/src/cni/bin/vrf /opt/cnis/vrf
