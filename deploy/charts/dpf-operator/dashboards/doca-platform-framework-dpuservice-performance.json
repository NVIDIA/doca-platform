      },
      "id": 1,
      "panels": [],
      "title": "DPU Cluster Capacity - Overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Total CPU cores used across the selected DPU nodes versus allocatable cores. Capacity is reported by the DPU in-cluster kube-state-metrics and is summed across all DPU clusters when more than one is present.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(k8s_node_cpu_usage{cluster=~\"$cluster\", k8s_node_name=~\"$node\"})",
          "legendFormat": "Used",
          "range": false,
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(kube_node_status_allocatable{resource=\"cpu\", job=~\"in-cluster-kube-state-metrics.*\", node=~\"$node\"})",
          "legendFormat": "Total",
          "range": false,
          "instant": true,
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "B",
            "mappings": [
              {
                "fieldName": "Total",
                "handlerKey": "max"
              }
            ]
          }
        }
      ],
      "title": "Cluster CPU (cores used of allocatable)",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Total working-set memory used across the selected DPU nodes versus memory capacity. Page cache is excluded because it is reclaimable, so this reads lower than the OS free/used figure.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "percentage",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(k8s_node_memory_working_set_bytes{cluster=~\"$cluster\", k8s_node_name=~\"$node\"})",
          "legendFormat": "Used",
          "range": false,
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(k8s_node_memory_working_set_bytes{cluster=~\"$cluster\", k8s_node_name=~\"$node\"} + k8s_node_memory_available_bytes{cluster=~\"$cluster\", k8s_node_name=~\"$node\"})",
          "legendFormat": "Total",
          "range": false,
          "instant": true,
          "refId": "B"
        }
      ],
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "B",
            "mappings": [
              {
                "fieldName": "Total",
                "handlerKey": "max"
              }
            ]
          }
        }
      ],
      "title": "Cluster Memory (working set used of capacity)",
      "type": "gauge"
    },
