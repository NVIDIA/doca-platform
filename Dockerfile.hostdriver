ARG builder_image
ARG hostdriver_base_image

# 1) dependency stage to create a dependency layer with go vendor folder and other dependencies
FROM --platform=${BUILDPLATFORM} ${builder_image} AS dependency
WORKDIR /workspace

# Copy source files needed for proper vendoring
COPY go.mod go.sum ./
COPY third_party/ third_party/
COPY api/ api/
COPY cmd/ cmd/
COPY test/ test/
COPY internal/ internal/
COPY pkg/ pkg/

# Vendor all dependencies with go build cache
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod vendor

# 2) Builder stage builds go binaries (no emulation).
FROM --platform=${BUILDPLATFORM} ${builder_image} AS builder
WORKDIR /workspace

ARG gcflags
ARG ldflags
ARG TARGETARCH

ENV GO_LDFLAGS=${ldflags}
ENV GO_GCFLAGS=${gcflags}
ENV ARCH=${TARGETARCH}
ENV TAG=${TAG}

# Copy the source code from the dependency image
COPY --from=dependency /workspace .

# Vendor dependencies first
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod vendor

RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=bind,source=Makefile,target=Makefile \
    --mount=type=bind,source=hack/tools/tools.mk,target=hack/tools/tools.mk \
    GOFLAGS="-mod=vendor" make binary-hostagent binary-dpuagent

# Copy the go source code so it can be distributed in the final image.
RUN mkdir src && \
    find . -name '*.go' -not -path "./hack/*" -not -path "./.gocache/*" \
    -exec cp --parents \{\}  src/ \; && \
    tar -czf source-code.tar.gz src

# 3) Version stage to create the DPF version file.
FROM ${builder_image} AS version
ARG TAG
# Write the DPF version file (separate stage to preserve builder cache when only TAG changes).
# The command echo is not present in the final image so this stage is needed.
RUN echo "${TAG}" > /tmp/dpf-version

# 4) DPU Agent packager stage - packages binary with actual TAG version
FROM --platform=${BUILDPLATFORM} ${builder_image} AS dpuagent-packager
WORKDIR /workspace

# Install rpm tools (required by nfpm for creating .rpm packages)
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends rpm dpkg-dev createrepo-c

# Copy packaging configuration and binary from builder
COPY internal/provisioning/dpuagent/packaging/ internal/provisioning/dpuagent/packaging/
COPY --from=builder /workspace/bin/dpuagent /workspace/bin/dpuagent

# Package with actual TAG version (binary already built, just call packaging targets)
ARG TAG
RUN --mount=type=cache,target=/workspace/hack/tools/bin,sharing=locked \
    --mount=type=bind,source=Makefile,target=Makefile \
    --mount=type=bind,source=hack/tools/tools.mk,target=hack/tools/tools.mk \
    make deb-dpuagent rpm-dpuagent

# Copy dpu-agent packages built with actual TAG version
RUN mkdir -p /deb /rpm \
    && cp /workspace/bin/dpu-agent_*_arm64.deb /deb/ \
    && cp /workspace/bin/dpu-agent-*.aarch64.rpm /rpm/

# Generate APT repository metadata
WORKDIR /deb
RUN dpkg-scanpackages -m . > Packages && gzip -k Packages

# Generate YUM/DNF repository metadata
WORKDIR /rpm
RUN createrepo_c .

# 5) Final stage copies artefacts from the builder and dependency stages.
FROM ${hostdriver_base_image}

ENV DEBIAN_FRONTEND=noninteractive
# Forces systemctl to connect via D-Bus instead of PID 1's private listener
ENV SYSTEMCTL_FORCE_BUS=1
# Tells systemd tools to try communicating with PID 1 even in container environments
ENV SYSTEMD_OFFLINE=0
# Legacy variable to ignore chroot detection (deprecated but still works)
ENV SYSTEMD_IGNORE_CHROOT=1

ARG TARGETARCH
ARG PACKAGES="dpkg-dev \
libusb-1.0-0 \
ipmitool \
rshim \
curl \
screen \
pv \
bridge-utils \
iptables \
iproute2 \
netplan.io \
createrepo-c"
# TODO(DMS, January 2027, doca-installer FR 5311865): once dmsd switches to the final doca-installer flow, which runs
# aarch64 binaries from the BFB on the host, add qemu-user-static to PACKAGES and keep only its aarch64 emulator:
#   find /usr/bin -name 'qemu-*-static' ! -name 'qemu-aarch64-static' -delete
# The interim dpu-deployment-tool path used by doca-dms 3.6.0068 does not need it.

ARG ubuntu_mirror=http://archive.ubuntu.com/ubuntu/
RUN find /etc/apt/sources.list* -type f -exec sed -i \
      -e "s|http://archive.ubuntu.com/ubuntu/|${ubuntu_mirror}|g" \
      -e "s|http://ports.ubuntu.com/ubuntu/|${ubuntu_mirror}|g" \
      -e "s|http://security.ubuntu.com/ubuntu/|${ubuntu_mirror}|g" '{}' \;

# dmsd shells out to doca-installer's dpu-deployment-tool to install BFBs (rshim >= 2.9.1 no longer ships
# bfb-install), but no DOCA package or meta-package depends on doca-installer, so it has to be requested by name.
# mft ships flint and mlxfwreset, which both doca-installer and the host agent need. Both come from the DOCA
# repository, which is dropped right after: it might not be available publicly, and it outranks Ubuntu, so
# leaving it enabled would let it override packages installed below.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update -qq \
      -o Dir::Etc::sourcelist=sources.list.d/doca.list \
      -o Dir::Etc::sourceparts=/dev/null && \
    apt-get install -y -qq --no-install-recommends doca-installer mft && \
    rm -f /etc/apt/sources.list.d/doca.list

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && \
    apt-get upgrade -y -qq && \
    apt-get install -y -qq --no-install-recommends ${PACKAGES}

RUN mkdir -p /bfb-folder

# Remove the /usr/sbin/reboot file first, since on some systems it is a symlink to /usr/bin/systemctl.
# Failing to do so replaces `systemctl` with `reboot`, causing every invocation of `systemctl` to trigger a reboot.
RUN rm -f /usr/sbin/reboot \
    && echo "dbus-send --system --print-reply --dest=org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager.Reboot boolean:false" > /usr/sbin/reboot \
    && chmod +x /usr/sbin/reboot

COPY --from=builder /workspace/bin/ .

WORKDIR /workspace

# Move source code to a directory
ARG PACKAGE_SOURCES
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    test "${PACKAGE_SOURCES}" = "false" || ( \
      mkdir /src && \
      cd /src && \
      # Enable deb-src to be able to fetch sources
      sed -i 's/^# deb-src/deb-src/g' /etc/apt/sources.list /etc/apt/sources.list.d/* && \
      sed -i 's/^Types: deb$/Types: deb deb-src/g' /etc/apt/sources.list.d/*.sources && \
      apt-get update && \
      apt-get source --download-only ${PACKAGES} && \
      cd / && \
      tar -cf pkg-source-code.tar /src && \
      rm -rf /src \
    )

# Copy source code from builder stage
COPY --chown=root:root --from=builder /workspace/source-code.tar.gz source-code.tar.gz

# Copy APT/YUM repositories containing dpu-agent packages
COPY --from=dpuagent-packager /deb /deb
COPY --from=dpuagent-packager /rpm /rpm

WORKDIR /

COPY --chown=root:root --from=version /tmp/dpf-version /etc/dpf-version
